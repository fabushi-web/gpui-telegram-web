# gpui-telegram-web Production Environment Variables
NODE_ENV=production
HOST=0.0.0.0
PORT=4173
DATA_DIR=./data

# REQUIRED in production: random 32+ byte secret for session tokens & Telegram.WebApp initData HMAC
SESSION_SECRET=replace-with-strong-random-32-byte-secret

# Optional: Transparently proxy all /api/* and WebSocket traffic to an existing Rust `gpui_telegram_server`
# Leave empty to run standalone Node.js + SQLite WAL production server
# UPSTREAM_SERVER_URL=http://34.46.77.133:8080

# ombhrum.com OAuth (Alipay) & AI Gateway integration
OMBHRUM_API_URL=https://api.ombhrum.com
AI_GATEWAY_URL=https://api.ombhrum.com/v1
# AI_GATEWAY_API_KEY=

# Optional WebRTC STUN/TURN servers (comma-separated)
# TURN_URIS=turn:turn.ombhrum.com:3478?transport=udp,turn:turn.ombhrum.com:3478?transport=tcp
# TURN_SECRET=

# Strict Production Guards (keep 0 in production!)
SEED_DEMO_DATA=0
ALLOW_DEMO_AUTH=0
EXPOSE_DEV_OTP_CODE=0
ENABLE_TEST_RESET=0
