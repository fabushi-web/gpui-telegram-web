# Fabushi Web (v1.6.11) Production Environment Variables
NODE_ENV=production
HOST=0.0.0.0
PORT=4173
DATA_DIR=./data

# REQUIRED in production: random 32+ byte secret for session tokens, vault keys & initData HMAC
# (Legacy alias: SESSION_SECRET)
GPUI_MASTER_SECRET=replace-with-strong-random-32-byte-secret

# Optional: Transparently proxy /api/*, /v1/*, /.well-known/*, /oauth/*, /mcp, /miniapps/*,
# /bot*/*, /js/*, and WebSocket traffic to an upstream Rust `gpui_telegram_server`.
# Leave empty to run standalone Node.js + SQLite WAL production server.
# UPSTREAM_SERVER_URL=https://your-upstream-server.example.com
PROXY_BROWSER_WS=0

# Cloud OAuth & AI Gateway integration (legacy aliases: OMBHRUM_API_URL, AI_GATEWAY_URL)
# Note: trailing `/v1` on AI gateway URLs is normalized automatically.
FABUSHI_CLOUD_GATEWAY_URL=https://api.ombhrum.com
FABUSHI_AI_GATEWAY_URL=https://ai.ombhrum.com
# AI_GATEWAY_API_KEY=

# Optional real OTP delivery webhooks (email / SMS)
# AUTH_SYSTEM_MAIL_URL=
# AUTH_SYSTEM_SMS_URL=

# Optional WebRTC STUN/TURN servers (comma-separated) & coturn static-auth-secret
# TURN_URIS=turn:turn.ombhrum.com:3478?transport=udp,turn:turn.ombhrum.com:3478?transport=tcp
# TURN_SECRET=

# Strict Production Guards (keep 0 in production!)
SEED_DEMO_DATA=0
ALLOW_DEMO_AUTH=0
EXPOSE_DEV_OTP_CODE=0
ENABLE_TEST_RESET=0
